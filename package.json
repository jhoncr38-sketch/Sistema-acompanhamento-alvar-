{
  "name": "alexandre-alvaras",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Alexandre Alvarás — Monitor de Licenças & Alvarás",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:validate": "node scripts/validate-migrations.mjs",
    "db:seed:generate": "node scripts/generate-seed-sql.ts",
    "assets:extract": "python scripts/extract-reference-assets.py",
    "check": "tsc -b && oxlint src scripts && vitest run && node scripts/validate-migrations.mjs",
    "build:edge": "vite build --config vite.edge.config.ts",
    "lint": "oxlint src scripts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "oxlint": "^1.86.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-router": "^8.4.0",
    "read-excel-file": "^9.3.10",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  }
}
